+// ==================== random, text fitting, style choice ====================
+
+private class KRng(
+    seed: Int,
+) {
+    private var a: Int = if (seed == 0) 1 else seed
+
+    fun next(): Float {
+        a += 0x6D2B79F5
+        var t = a
+        t = (t xor (t ushr 15)) * (t or 1)
+        t = t xor (t + (t xor (t ushr 7)) * (t or 61))
+        return (((t xor (t ushr 14)).toLong() and 0xFFFFFFFFL).toDouble() / 4294967296.0).toFloat()
+    }
+}
+
+private fun KRng.pick(vararg weighted: Pair<KineticStyle, Float>): KineticStyle {
+    var x = next() * weighted.sumOf { it.second.toDouble() }.toFloat()
+    for ((v, k) in weighted) {
+        x -= k
+        if (x <= 0f) return v
+    }
+    return weighted[0].first
+}
+
+/** Auto: picks the style for a line from its length, singing speed and chorus repeats. */
+private fun chooseKind(
+    line: KLine,
+    seed: Int,
+): KineticStyle {
+    val r = KRng(seed)
+    val n = line.words.size
+    val wps = n / max(0.5f, (line.endMs - line.startMs) / 1000f)
+    val energetic = wps > 2.5f
+    val calm = wps < 1.4f
+    val chorus = line.repeats >= 2
+    return when {
+        n <= 2 -> r.pick(KineticStyle.Zoom to 3f, KineticStyle.Letters to 2f, KineticStyle.Stack to 1f)
+        n > 11 || wps > 3.8f -> r.pick(KineticStyle.Flow to 3f, KineticStyle.Slide to 2f)
+        chorus && n <= 7 ->
+            if (energetic) {
+                r.pick(KineticStyle.Zoom to 2f, KineticStyle.Slide to 2f, KineticStyle.Letters to 1f)
+            } else {
+                r.pick(KineticStyle.Stack to 2f, KineticStyle.Letters to 1f, KineticStyle.Zoom to 1f)
+            }
+
+        else ->
+            r.pick(
+                KineticStyle.Stack to (if (calm) 3f else 2f),
+                KineticStyle.Slide to (if (energetic) 3f else 2f),
+                KineticStyle.Graph to (if (n <= 8) (if (calm) 2.5f else 1.5f) else 0f),
+                KineticStyle.Scatter to (if (energetic) 2f else 1f),
+                KineticStyle.Zoom to (if (energetic) 2f else 1f),
+                KineticStyle.Letters to 1.5f,
+                KineticStyle.Flow to (if (calm) 2f else 0.5f),
+            )
+    }
+}
+
+private fun visualLength(s: String): Float {
+    var n = 0f
+    for (ch in s.uppercase()) {
+        val code = ch.code
+        n +=
+            when {
+                code in 0x3040..0x30FF || code in 0x4E00..0x9FFF || code in 0xAC00..0xD7AF -> 1f
+                code in 0x0900..0x097F -> 0.62f
+                ch == 'M' || ch == 'W' || ch == '@' -> 0.98f
+                ch == 'I' || ch in ".,'!|:;" -> 0.3f
+                ch == 'J' -> 0.56f
+                ch == ' ' -> 0.26f
+                ch.isDigit() -> 0.66f
+                else -> 0.72f
+            }
+    }
+    return max(n, 0.5f)
+}
+
+/** Font size in px for [rowCount] rows whose widest row is [longest] em wide (percent of the stage). */
+private fun fitPx(
+    longest: Float,
+    rowCount: Int,
+    c: KCtx,
+    widthPct: Float = 82f,
+    heightPct: Float = 62f,
+    maxPct: Float = 16f,
+): Float {
+    val vw = min(maxPct, widthPct / max(0.5f, longest))
+    val vh = heightPct / max(1, rowCount) / 1.05f
+    return min(vw * c.w / 100f, vh * c.h / 100f)
+}
+
+private fun fitRows(
+    c: KCtx,
+    rows: List<List<Int>>,
+    widthPct: Float,
+    maxPct: Float,
+    heightPct: Float = 62f,
+): Float {
+    val longest = rows.maxOf { row -> visualLength(row.joinToString(" ") { c.line.words[it].text }) }
+    return fitPx(longest, rows.size, c, widthPct, heightPct, maxPct)
+}
+
+/** Groups word indices into at most [maxRows] rows of similar visual width. */
+private fun groupRows(
+    words: List<KWord>,
+    maxRows: Int,
+): List<List<Int>> {
+    if (words.size <= maxRows) return words.indices.map { listOf(it) }
+    val total = words.sumOf { (visualLength(it.text) + 0.3f).toDouble() }.toFloat()
+    val target = total / maxRows
+    val rows = mutableListOf(mutableListOf<Int>())
+    var width = 0f
+    words.forEachIndexed { i, w ->
+        val len = visualLength(w.text) + 0.3f
+        if (width > 0f && width + len / 2f > target && rows.size < maxRows) {
+            rows.add(mutableListOf())
+            width = 0f
+        }
+        rows.last().add(i)
+        width += len
+    }
+    return rows
+}
+
+private val TinyWords =
+    setOf("a", "an", "the", "to", "of", "in", "on", "at", "by", "for", "and", "or", "but", "so", "is", "am", "are", "be", "i", "me", "my", "we", "it", "oh")
+
+private fun cleanWord(s: String): String = s.lowercase().filter { it.isLetter() || it == '\'' }
+
+/** One to four real words of a line get the album accent colour (random, but stable for a line). */
+private fun highlightSet(
+    line: KLine,
+    seed: Int,
+): Set<Int> {
+    val r = KRng(seed xor 0x51ed27)
+    var pool = line.words.indices.filter { cleanWord(line.words[it].text) !in TinyWords }.toMutableList()
+    if (pool.isEmpty()) pool = line.words.indices.toMutableList()
+    for (i in pool.size - 1 downTo 1) {
+        val j = (r.next() * (i + 1)).toInt().coerceIn(0, i)
+        val tmp = pool[i]
+        pool[i] = pool[j]
+        pool[j] = tmp
+    }
+    val count = (line.words.size * (0.18f + r.next() * 0.17f)).roundToInt().coerceIn(1, min(4, pool.size))
+    return pool.take(count).toSet()
+}
+
+private fun splitLetters(word: String): List<String> {
+    val it = BreakIterator.getCharacterInstance()
+    it.setText(word)
+    val out = ArrayList<String>()
+    var s = it.first()
+    var e = it.next()
+    while (e != BreakIterator.DONE) {
+        out += word.substring(s, e)
+        s = e
+        e = it.next()
+    }
+    return out.ifEmpty { listOf(word) }
+}
