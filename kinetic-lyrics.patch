+// ==================== entry point ====================
+
+private class RippleBuffer {
+    val data = FloatArray(32)
+    private var next = 0
+
+    fun add(
+        x: Float,
+        y: Float,
+        t: Float,
+    ) {
+        val i = (next++ % 8) * 4
+        data[i] = x
+        data[i + 1] = y
+        data[i + 2] = t
+        data[i + 3] = 1f
+    }
+}
+
+private class BoxInfo {
+    var pos = Offset.Zero
+    var w = 1f
+    var h = 1f
+}
+
+private val NoRipples = FloatArray(32)
+
+@Composable
+internal fun KineticLyricsUI(
+    modifier: Modifier,
+    lines: List<LyricItem>,
+    currentTimeProvider: () -> Long,
+    seekPreviewTimeProvider: () -> Long?,
+    settings: LyricsStyleSettings,
+    displayMode: LyricsDisplayMode,
+) {
+    val kLines = remember(lines) { buildKineticLines(lines) }
+    val salt = remember(kLines) { Random.nextInt() }
+    val accents = kineticAccents()
+    val clock = remember { mutableFloatStateOf(0f) }
+    val timeMs = remember { mutableLongStateOf(0L) }
+    val timeProvider by rememberUpdatedState(currentTimeProvider)
+    val seekProvider by rememberUpdatedState(seekPreviewTimeProvider)
+    LaunchedEffect(Unit) {
+        var start = -1L
+        while (true) {
+            withFrameNanos { now ->
+                if (start < 0L) start = now
+                clock.floatValue = (now - start) / 1_000_000_000f
+                timeMs.longValue = seekProvider() ?: timeProvider()
+            }
+        }
+    }
+    val ripples = remember { RippleBuffer() }
+    val info = remember { BoxInfo() }
+    val lineIndex by remember(kLines) { derivedStateOf { lastStartedIndex(kLines, timeMs.longValue) } }
+    val topInset =
+        if (displayMode == LyricsDisplayMode.Fullscreen) {
+            WindowInsets.statusBars.asPaddingValues().calculateTopPadding() + 76.dp
+        } else {
+            12.dp
+        }
+    val bottomInset = if (displayMode == LyricsDisplayMode.Fullscreen) 132.dp else 12.dp
+
+    Box(
+        modifier =
+            modifier
+                .fillMaxSize()
+                .clipToBounds()
+                .onGloballyPositioned {
+                    info.pos = it.positionInRoot()
+                    info.w = max(1f, it.size.width.toFloat())
+                    info.h = max(1f, it.size.height.toFloat())
+                },
+    ) {
+        KineticBackground(
+            clock = clock,
+            ripples = ripples,
+            accents = accents,
+            ripplesOn = settings.kineticRipples,
+            modifier = Modifier.fillMaxSize(),
+        )
+        val index = lineIndex
+        if (index >= 0 && index < kLines.size) {
+            key(index) {
+                KineticStage(
+                    line = kLines[index],
+                    salt = salt,
+                    timeMs = timeMs,
+                    settings = settings,
+                    accents = accents,
+                    topInset = topInset,
+                    bottomInset = bottomInset,
+                    onReveal = { rootCenter ->
+                        if (settings.kineticRipples) {
+                            ripples.add(
+                                (rootCenter.x - info.pos.x) / info.w,
+                                (rootCenter.y - info.pos.y) / info.h,
+                                clock.floatValue,
+                            )
+                        }
+                    },
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun kineticAccents(): List<Color> {
+    val cs = MaterialTheme.colorScheme
+    return remember(cs.primary, cs.tertiary, cs.secondary) {
+        listOf(cs.primary, cs.tertiary, cs.secondary).map { lerpColor(it, Color.White, 0.18f) }
+    }
+}
+
+private class KCtx(
+    val line: KLine,
+    val revealed: Int,
+    val seed: Int,
+    val highlights: Set<Int>,
+    val accent: Color,
+    val w: Float,
+    val h: Float,
+    val onReveal: (Offset) -> Unit,
+) {
+    fun color(i: Int): Color = if (i in highlights) accent else Color.White
+
+    fun shown(i: Int): Boolean = i < revealed
+}
+
+@Composable
+private fun KineticStage(
+    line: KLine,
+    salt: Int,
+    timeMs: State<Long>,
+    settings: LyricsStyleSettings,
+    accents: List<Color>,
+    topInset: Dp,
+    bottomInset: Dp,
+    onReveal: (Offset) -> Unit,
+) {
+    val seed = line.text.hashCode() xor salt
+    val kind =
+        remember(line, settings.kineticStyle, seed) {
+            if (settings.kineticStyle == KineticStyle.Auto) chooseKind(line, seed) else settings.kineticStyle
+        }
+    val highlights = remember(line, seed) { highlightSet(line, seed) }
+    val revealed by remember(line) { derivedStateOf { line.words.count { it.startMs <= timeMs.longValue } } }
+    val accent = accents[((seed ushr 3) and 0x7fffffff) % 3]
+    val density = LocalDensity.current
+
+    BoxWithConstraints(
+        modifier =
+            Modifier
+                .fillMaxSize()
+                .padding(top = topInset, bottom = bottomInset),
+        contentAlignment = Alignment.Center,
+    ) {
+        val w = with(density) { maxWidth.toPx() }
+        val h = with(density) { maxHeight.toPx() }
+        val ctx = KCtx(line, revealed, seed, highlights, accent, w, h, onReveal)
+        val scale = settings.kineticSize / 100f
+        val shift = (settings.kineticPosition - 50) / 50f * h * 0.35f
+        Box(
+            modifier =
+                Modifier.graphicsLayer {
+                    scaleX = scale
+                    scaleY = scale
+                    translationY = shift
+                },
+            contentAlignment = Alignment.Center,
+        ) {
+            when (kind) {
+                KineticStyle.Stack -> StackTemplate(ctx)
+                KineticStyle.Slide -> SlideTemplate(ctx)
+                KineticStyle.Zoom -> ZoomTemplate(ctx)
+                KineticStyle.Letters -> LettersTemplate(ctx)
+                KineticStyle.Scatter -> ScatterTemplate(ctx)
+                KineticStyle.Graph -> GraphTemplate(ctx)
+                KineticStyle.Flow -> FlowTemplate(ctx)
+                KineticStyle.Auto -> StackTemplate(ctx)
+            }
+        }
+    }
+}
