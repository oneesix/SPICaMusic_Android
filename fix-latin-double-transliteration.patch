 private fun isRomanText(text: String): Boolean = text.all { !it.isLetter() || it.code < 0x250 }
 
+/** True when a romanization would only repeat a lyric that is already written in Latin letters. */
+private fun duplicatesLatinLyric(
+    lyricText: String,
+    romanization: String,
+): Boolean {
+    val lyric = lyricText.trim()
+    if (lyric.isEmpty()) return false
+    return isRomanText(lyric) || romanization.trim().equals(lyric, ignoreCase = true)
+}
