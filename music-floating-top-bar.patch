+        LyricsSettingsSlider(
+            label = stringResource(R.string.bb_width),
+            description = "",
+            value = custom.width,
+            range = 55..100,
+            step = 1,
+            valueText = { "$it%" },
+            onValueChange = { onInt(MusicTopBarSetting.Width, it) },
