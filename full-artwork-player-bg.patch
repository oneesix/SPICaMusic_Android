+@Composable
+private fun StackCover(
+    artwork: MusicArtwork?,
+    side: Dp,
+    flipped: Boolean,
+) {
+    Box(
+        modifier =
+            Modifier
+                .fillMaxWidth()
+                .height(side)
+                .graphicsLayer { if (flipped) scaleY = -1f },
+    ) {
+        AudioCover(artwork = artwork, modifier = Modifier.fillMaxSize())
+    }
+}
