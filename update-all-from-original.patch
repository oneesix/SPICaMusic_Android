+/** Verse Flow 开启时，用 HTML 同款配色覆盖 Material 颜色（文字、图标、滑块都跟着变）。 */
+@Composable
+private fun PlayerThemeScope(
+    isVerseFlow: Boolean,
+    theme: me.spica27.spicamusic.ui.widget.VerseTheme,
+    content: @Composable () -> Unit,
+) {
+    if (isVerseFlow) {
+        VerseFlowThemeScope(theme = theme, content = content)
+    } else {
+        content()
+    }
+}
