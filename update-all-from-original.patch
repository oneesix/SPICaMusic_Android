+/** Verse Flow 歌词页色块：数量、大小、不透明度、颜色、动效速度，以及动画开关（关闭后完全静态）。 */
+@Composable
+private fun VerseBlobControls(
+    mesh: VerseMeshSettings,
+    onChange: (VerseMeshSettings) -> Unit,
+    onReset: () -> Unit,
+) {
+    Column(
+        modifier =
+            Modifier
+                .fillMaxWidth()
+                .padding(
+                    start = SettingsRowContentInset,
+                    end = Spacing.Large,
