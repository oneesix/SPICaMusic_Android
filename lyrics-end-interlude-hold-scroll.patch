+/** The oldest line, at most [maxHold] lines before [latest], that is still being sung at [time]. */
+private fun heldLineIndex(
+    lines: List<LyricItem>,
+    latest: Int,
+    time: Long,
+    maxHold: Int,
+): Int {
+    var focus = latest
+    var i = latest - 1
+    while (i >= 0 && latest - i <= maxHold) {
+        val end = lines[i].knownEndMs() ?: break
+        if (end <= time) break
+        focus = i
+        i--
+    }
+    return focus
+}
