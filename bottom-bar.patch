+        layerBlock = {
+            scaleX = scaleXProvider()
+            scaleY = scaleYProvider()
+            alpha = alphaProvider()
+        },
+        onDrawSurface = { drawRect(Color.White.copy(alpha = 0.08f)) },
+    )
