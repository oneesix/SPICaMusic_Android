+            val speed = Random.nextFloat() * SPEED_RANGE + MIN_SPEED
+            val velocityX = cos(angle) * speed
+            val velocityY = sin(angle) * speed - Random.nextFloat() * UPWARD_VELOCITY
+
+            particles +=
