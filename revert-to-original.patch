+                    startX = x.toFloat(),
+                    startY = y.toFloat(),
+                    velocityX = velocityX,
+                    velocityY = velocityY,
+                    accelerationX = (Random.nextFloat() - 0.5f) * HORIZONTAL_ACCELERATION,
+                    accelerationY = Random.nextFloat() * VERTICAL_ACCELERATION_RANGE + MIN_VERTICAL_ACCELERATION,
