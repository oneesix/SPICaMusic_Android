+    /** "Artist/Album/Song/drums.opus" for a zip entry inside a "mixing" folder, otherwise null. */
+    private fun mixingRelativePath(entryName: String): String? {
+        val parts = entryName.replace('\\', '/').split('/').filter { it.isNotEmpty() }
+        val at = parts.indexOfFirst { it.equals("mixing", ignoreCase = true) }
+        if (at < 0 || at == parts.lastIndex) return null
+        val rest = parts.subList(at + 1, parts.size)
+        if (rest.any { it == ".." || it == "." }) return null
+        return rest.joinToString("/")
+    }
+
+    /** Copy one zip entry to Music/mixing/<relative>. Entries that would leave that folder are skipped. */
+    private fun extractMixingEntry(
+        zin: ZipInputStream,
+        relative: String,
+    ): Boolean {
+        val root = MixingLibrary.rootDir()
+        val target = File(root, relative)
+        if (!target.canonicalPath.startsWith(root.canonicalPath + File.separator)) return false
+        target.parentFile?.mkdirs()
+        val part = File(target.parentFile, target.name + ".part")
+        part.outputStream().use { zin.copyTo(it, 64 * 1024) }
+        if (target.exists()) target.delete()
+        return part.renameTo(target)
+    }
