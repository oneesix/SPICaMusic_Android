-// drift of each blob: (start x, start y) as fraction of the screen, (tx, ty) as fraction of the blob size
-private class BlobSpec(
-    val x0: (w: Float, d: Float) -> Float,
-    val y0: (h: Float, d: Float) -> Float,
-    val tx: Float,
-    val ty: Float,
-    val scaleTo: Float,
-    /** loop length relative to the fastest blob (24 s / 31 s / 28 s / 35 s in the HTML) */
-    val periodFactor: Float,
-)
-
-private val BlobSpecs =
-    listOf(
-        BlobSpec({ w, _ -> -.25f * w }, { h, _ -> -.08f * h }, .38f, .22f, 1.18f, 1f),
-        BlobSpec({ w, d -> 1.32f * w - d }, { h, _ -> .16f * h }, -.34f, .30f, .90f, 31f / 24f),
-        BlobSpec({ w, _ -> -.22f * w }, { h, d -> .90f * h - d }, .30f, -.28f, 1.15f, 28f / 24f),
-        BlobSpec({ w, d -> 1.22f * w - d }, { h, d -> 1.10f * h - d }, -.36f, -.20f, 1.05f, 35f / 24f),
-    )
-
-/**
- * Light on purpose: the animation state is read only while drawing (no recomposition per frame),
- * no off-screen layer is used (the opacity is applied to each blob's colour), and with
- * animation off nothing runs at all after the first frame.
- */
-@Composable
-private fun VerseMesh(
-    theme: VerseTheme,
-    settings: VerseMeshSettings,
-    alpha: Float,
-    animated: Boolean,
-    modifier: Modifier = Modifier,
-) {
-    val count = settings.blobCount.coerceIn(1, 4)
-    val periodMs = settings.motionSeconds.coerceIn(5, 60) * 1000
-
-    val phases: List<State<Float>> =
-        if (animated) {
-            val t = rememberInfiniteTransition(label = "verse_mesh")
-            List(count) { i ->
-                t.animateFloat(
-                    initialValue = 0f,
-                    targetValue = 1f,
-                    animationSpec =
-                        infiniteRepeatable(
-                            animation = tween((periodMs * BlobSpecs[i].periodFactor).toInt(), easing = FastOutSlowInEasing),
-                            repeatMode = RepeatMode.Reverse,
-                        ),
-                    label = "verse_mesh_$i",
-                )
-            }
-        } else {
-            emptyList()
-        }
-
-    val k = settings.colorPercent / 50f
-    val colors =
-        listOf(
-            lerp(theme.c2, theme.fg, (.60f * k).coerceIn(0f, 1f)),
-            theme.c4.copy(alpha = (theme.c4.alpha * k).coerceIn(0f, 1f)),
-            lerp(theme.c3, theme.fg, (.35f * k).coerceIn(0f, 1f)),
-            lerp(theme.c2, theme.fg, (.25f * k).coerceIn(0f, 1f)),
-        )
-    val sizeFactor = .45f + settings.sizePercent / 100f
-
-    Canvas(modifier = modifier) {
-        val w = size.width
-        val h = size.height
-        val d = w * sizeFactor
-        for (i in 0 until count) {
-            val spec = BlobSpecs[i]
-            val p = if (animated) phases[i].value else .5f
-            val cx = spec.x0(w, d) + d / 2f + d * spec.tx * p
-            val cy = spec.y0(h, d) + d / 2f + d * spec.ty * p
-            val r = d / 2f * (1f + (spec.scaleTo - 1f) * p)
-            val c = colors[i]
-            drawCircle(
-                brush =
-                    Brush.radialGradient(
-                        listOf(c.copy(alpha = c.alpha * alpha), c.copy(alpha = 0f)),
-                        center = Offset(cx, cy),
-                        radius = r,
-                    ),
-                radius = r,
-                center = Offset(cx, cy),
-            )
-        }
-    }
-}
