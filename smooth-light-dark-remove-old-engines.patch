-// ---------------------------------------------------------------------------------------------
-// Background: `.bg` gradient (+ the `.mesh` drifting blobs in lyrics view)
-// ---------------------------------------------------------------------------------------------
-
-/**
- * CSS:
- *   radial-gradient(110% 60% at 92% 4%, var(--c4), transparent 62%),
- *   linear-gradient(180deg, var(--c1) 0%, var(--c2) 55%, var(--c3) 100%)
- * and, while the lyrics are shown, up to four slowly drifting radial blobs.
- */
-@Composable
-fun VerseFlowBackground(
-    theme: VerseTheme,
-    showMesh: Boolean,
-    modifier: Modifier = Modifier,
-    mesh: VerseMeshSettings = VerseMeshSettings(),
-    /** Host switch (app in background / system animations off). */
-    meshAnimated: Boolean = true,
-) {
-    val meshAlpha by animateFloatAsState(
-        targetValue = if (showMesh) mesh.opacityPercent / 100f else 0f,
-        animationSpec = tween(600),
-        label = "verse_mesh_alpha",
-    )
-    Box(modifier = modifier) {
-        Canvas(modifier = Modifier.fillMaxSize()) {
-            val w = size.width
-            val h = size.height
-            drawRect(
-                brush =
-                    Brush.verticalGradient(
-                        0f to theme.c1,
-                        .55f to theme.c2,
-                        1f to theme.c3,
-                    ),
-            )
-            // ellipse 110% x 60% centred at (92 %, 4 %), fading out at 62 %
-            val cx = w * .92f
-            val cy = h * .04f
-            val rx = w * 1.10f
-            val ry = h * .60f
-            scale(scaleX = 1f, scaleY = ry / rx, pivot = Offset(cx, cy)) {
-                drawRect(
-                    brush =
-                        Brush.radialGradient(
-                            colors = listOf(theme.c4, theme.c4.copy(alpha = 0f)),
-                            center = Offset(cx, cy),
-                            radius = rx * .62f,
-                        ),
-                    topLeft = Offset(-w * 4f, -h * 4f),
-                    size = Size(w * 9f, h * 9f),
-                )
-            }
-        }
-        if (meshAlpha > 0.001f) {
-            VerseMesh(
-                theme = theme,
-                settings = mesh,
-                alpha = meshAlpha,
-                animated = meshAnimated && mesh.animated,
-                modifier = Modifier.fillMaxSize(),
-            )
-        }
-    }
-}
