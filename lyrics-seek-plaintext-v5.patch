 // ==================== 辅助组件 ====================
 
+/**
+ * Shown while the progress bar is dragged: the plain text of the line at the bar's time with its
+ * timestamp below. No word progress, blur, scale or fade, so dragging stays light.
+ */
+@Composable
+private fun BarSeekLine(
+    lines: List<LyricItem>,
+    indexProvider: () -> Int?,
+    style: LyricsUIStyle,
+    modifier: Modifier = Modifier,
+) {
+    val line = indexProvider()?.let { lines.getOrNull(it) } ?: return
+    val text =
+        when {
+            line.isInterlude() -> "\u2022 \u2022 \u2022"
+            line is LyricItem.WordsLyric ->
+                line.content?.takeIf { it.isNotBlank() } ?: line.words.joinToString(separator = "") { it.content }
+            line is LyricItem.NormalLyric -> line.content
+            else -> ""
+        }
+    val color = MaterialTheme.colorScheme.onSurface
+    Column(
+        modifier =
+            modifier
+                .fillMaxWidth()
+                .padding(horizontal = LyricUIConstants.SEEK_PREVIEW_END_PADDING.dp)
+                .padding(horizontal = style.horizontalPadding, vertical = style.verticalPadding),
+    ) {
+        Text(
+            text = text,
+            style = if (line is LyricItem.WordsLyric) style.wordsTextStyle else style.mainTextStyle,
+            color = color,
+        )
+        Text(
+            text = formatLyricTime(line.time),
+            style = MaterialTheme.typography.labelMedium,
+            color = color.copy(alpha = 0.6f),
+            modifier = Modifier.padding(top = 4.dp),
+        )
+    }
+}
