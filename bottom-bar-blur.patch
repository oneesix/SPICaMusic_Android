+/** 底栏后面的渐进模糊：与音乐页顶栏同一思路，但向上渐隐；只采样下面的列表，不带色调。 */
+@OptIn(ExperimentalHazeApi::class)
+@Composable
+private fun BottomBlurBand(
+    hazeState: HazeState,
+    amount: Int,
+    solidHeight: Dp,
+    fadeHeight: Dp,
+    alpha: () -> Float,
+) {
+    val background = MaterialTheme.colorScheme.background
+    val hardStyle =
+        remember(background, amount) {
+            HazeBlurStyle {
+                blurRadius(amount.dp)
+                noiseFactor(0f)
+                fallbackColorEffect(HazeColorEffect.tint(background.copy(alpha = 0.85f)))
+            }
+        }
+    val fadeStyle =
+        remember(background, amount) {
+            HazeBlurStyle {
+                blurRadius(amount.dp)
+                noiseFactor(0f)
+                fallbackColorEffect(HazeColorEffect.tint(background.copy(alpha = 0.85f)))
+                progressive(HazeProgressive.verticalGradient(startIntensity = 0f, endIntensity = 1f))
+            }
+        }
+    Column(Modifier.fillMaxSize().graphicsLayer { this.alpha = alpha() }) {
+        if (fadeHeight > 0.dp) {
+            Box(
+                Modifier
+                    .fillMaxWidth()
+                    .height(fadeHeight)
+                    .hazeBlur(
+                        input = HazeInput.Sources(hazeState),
+                        style = fadeStyle,
+                        performanceMode = HazePerformanceMode.Balanced,
+                    ),
+            )
+        }
+        if (solidHeight > 0.dp) {
+            Box(
+                Modifier
+                    .fillMaxWidth()
+                    .height(solidHeight)
+                    .hazeBlur(
+                        input = HazeInput.Sources(hazeState),
+                        style = hardStyle,
+                        performanceMode = HazePerformanceMode.Balanced,
+                    ),
+            )
+        }
+    }
+}
